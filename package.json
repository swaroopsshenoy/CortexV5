{
  "name": "cortexv5",
  "version": "1.0.0",
  "main": "src/electron/main/main.js",
  "scripts": {
    "electron:start": "npm run renderer:build && electron .",
    "electron:dev": "cross-env ELECTRON_USE_DEV_SERVER=true ELECTRON_RENDERER_URL=http://localhost:5174 wait-on tcp:5174 && electron .",
    "renderer:dev": "vite --config vite.config.mjs",
    "renderer:build": "vite build --config vite.config.mjs",
    "dev": "concurrently -k \"npm:renderer:dev\" \"npm:electron:dev\"",
    "build": "npm run renderer:build",
    "dist": "npm run renderer:build && electron-builder",
    "test": "node --test src/electron/main/errorExplanationService.test.js src/electron/main/astAnalysisService.test.js src/electron/main/optimizationSuggestionService.test.js src/electron/main/executionSimulatorService.test.js src/electron/main/benchmarkRunnerService.test.js src/electron/main/comparativeProfilingService.test.js src/electron/main/clangService.test.js src/electron/main/performanceRiskFeatures.test.js src/electron/main/performanceRiskService.test.js src/electron/main/nlpExplanationService.test.js src/electron/main/reportService.test.js src/electron/main/autoSaveService.test.js src/electron/main/integration/pipeline.test.js src/electron/main/integration/stability.test.js"
  },
  "build": {
    "appId": "com.cortex.v5",
    "productName": "Cortex++ V5",
    "npmRebuild": false,
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "src/electron/**/*",
      "src/shared/**/*",
      "dist/renderer/**/*",
      "resources/**/*",
      "!resources/ml_performance_dataset/programs/**"
    ],
    "extraResources": [
      {
        "from": "dist/python",
        "to": "python",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cortex++ V5"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.4.2",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}